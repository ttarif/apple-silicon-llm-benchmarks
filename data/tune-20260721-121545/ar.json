      "text": "    def _parse_line(line: str, idx: int) -> PromptCase:\n        try:\n            data = json.loads(line)\n        except json.JSONDecodeError as e:\n            raise ValueError(f\"Invalid JSON at line {idx}: {e}\") from e\n\n        if not isinstance(data, dict):\n            raise ValueError(f\"Expected dict at line {idx}, got {type(data).__name__}\")\n\n        missing = [k for k in (\"id\", \"category\", \"prompt\") if k not in data]\n        if missing:\n            raise ValueError(f\"Missing fields {missing} at line {idx}\")\n\n        return PromptCase(\n            id=str(data[\"id\"]),\n            category=str(data[\"category\"]),\n            prompt=str(data[\"prompt\"]),\n            max_tokens=int(data.get(\"max_tokens\", 128)),\n            notes=str(data.get(\"notes\", \"\")),\n        )\n\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        return [_parse_line(line, idx) for idx, line in enumerate(f) if line.strip()]\n\n\ndef filter_suite(\n    suite: Iterable[PromptCase],\n    *,\n    categories: Iterable[str] | None = None,\n    min_tokens: int | None = None,\n    max_tokens: int | None = None,\n) -> list[PromptCase]:\n    \"\"\"Filter prompt suite by category and token constraints.\"\"\"\n    cat_set = set(categories) if categories else None\n    result: list[PromptCase] = []\n    for case in suite:\n        if cat_set is not None and case.category not in cat_set:\n            continue\n        if min_tokens is not None and case.max_tokens < min_tokens:\n            continue\n        if max_tokens is not None and case.max_tokens > max_tokens:\n            continue\n        result.append(case)\n    return result\n\n\ndef deduplicate_suite(suite: Iterable[PromptCase]) -> list[PromptCase]:\n    \"\"\"Remove duplicate prompts by SHA-256 hash, preserving first occurrence.\"\"\"\n    seen: set[str] = set()\n    result: list[PromptCase] = []\n    for case in suite:\n        if case.prompt_sha256 not in seen:\n            seen.add(case.prompt_sha256)\n            result.append(case)\n    return result\n\n\ndef save_suite(suite: Iterable[PromptCase], path: Path",
