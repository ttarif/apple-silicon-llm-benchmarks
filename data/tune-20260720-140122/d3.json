          "text": "    suite: list[PromptCase] = []\n    required_fields = {\"id\", \"category\", \"prompt\"}\n\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            line = line.strip()\n            if not line:\n                continue\n\n            try:\n                data: dict[str, Any] = json.loads(line)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON at line {line_num}: {e}\") from e\n\n            missing = required_fields - set(data.keys())\n            if missing:\n                raise ValueError(f\"Missing fields at line {line_num}: {missing}\")\n\n            if not isinstance(data[\"id\"], str) or not data[\"id\"]:\n                raise ValueError(f\"Invalid 'id' at line {line_num}\")\n            if not isinstance(data[\"category\"], str) or not data[\"category\"]:\n                raise ValueError(f\"Invalid 'category' at line {line_num}\")\n            if not isinstance(data[\"prompt\"], str):\n                raise ValueError(f\"Invalid 'prompt' at line {line_num}\")\n\n            max_tokens = data.get(\"max_tokens\", 128)\n            if not isinstance(max_tokens, int) or max_tokens <= 0:\n                raise ValueError(f\"Invalid 'max_tokens' at line {line_num}\")\n\n            notes = data.get(\"notes\", \"\")\n            if not isinstance(notes, str):\n                raise ValueError(f\"Invalid 'notes' at line {line_num}\")\n\n            suite.append(\n                PromptCase(\n                    id=data[\"id\"],\n                    category=data[\"category\"],\n                    prompt=data[\"prompt\"],\n                    max_tokens=max_tokens,\n                    notes=notes,\n                )\n            )\n\n    seen_ids: set[str] = set()\n    for case in suite:\n        if case.id in seen_ids:\n            raise ValueError(f\"Duplicate id '{case.id}'\")\n        seen_ids.add(case.id)\n\n    return suite\n\n\ndef filter_suite(\n    suite: Iterable[PromptCase],\n    *,\n    categories: Iterable[str] | None = None,\n    min_tokens: int | None = None,\n    max_tokens: int | None = None,\n) -> list[PromptCase]:\n    \"\"\"Filter prompt suite by constraints.\"\"\"\n    result: list[PromptCase] = []",
