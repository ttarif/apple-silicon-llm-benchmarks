          "text": "def load_prompt_suite(path: Path) -> list[PromptCase]:\n    \"\"\"Load a JSONL prompt suite and validate required fields.\"\"\"\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found: {path}\")\n\n    entries: list[PromptCase] = []\n\n    for raw_line in path.read_text(encoding=\"utf-8\").splitlines():\n        raw_line = raw_line.strip()\n        if not raw_line:\n            continue\n\n        try:\n            record: dict[str, Any] = json.loads(raw_line)\n        except json.JSONDecodeError as e:\n            raise ValueError(f\"Invalid JSON in line {path.relative_to(path.parent).parts[-1]}: {e}\") from e\n\n        required_fields = {\"id\", \"category\", \"prompt\"}\n        missing = required_fields - set(record.keys())\n        if missing:\n            raise ValueError(f\"Missing required fields in line {path.relative_to(path.parent).parts[-1]}: {missing}\")\n\n        entry = PromptCase(\n            id=str(record[\"id\"]),\n            category=str(record[\"category\"]),\n            prompt=str(record[\"prompt\"]),\n            max_tokens=int(record.get(\"max_tokens\", 128)),\n            notes=str(record.get(\"notes\", \"\")),\n        )\n        entries.append(entry)\n\n    return entries\n\n\ndef write_prompt_suite(data: list[PromptCase], path: Path) -> None:\n    \"\"\"Write a list of PromptCase to a JSONL file.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n\n    lines: list[str] = []\n    for case in data:\n        record = asdict(case)\n        record[\"prompt_sha256\"] = case.prompt_sha256\n        lines.append(json.dumps(record, ensure_ascii=False))\n\n    path.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\n\n\ndef deduplicate_prompts(data: list[PromptCase]) -> list[PromptCase]:\n    \"\"\"Remove duplicate prompts based on prompt_sha256, keeping first occurrence.\"\"\"\n    seen: set[str] = set()\n    unique: list[PromptCase] = []\n\n    for case in data:\n        sha = case.prompt_sha256\n        if sha not in seen:\n            seen.add(sha)\n            unique.append(case)\n\n    return unique\n\n\ndef index_prompts(data: list[PromptCase]) -> dict[str",
