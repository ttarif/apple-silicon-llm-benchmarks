          "text": "def load_prompt_suite(path: Path) -> list[PromptCase]:\n    \"\"\"Load a JSONL prompt suite and validate required fields.\"\"\"\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found at {path}\")\n    \n    cases: list[PromptCase] = []\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            line = line.strip()\n            if not line:\n                continue\n            \n            try:\n                obj: dict[str, Any] = json.loads(line)\n            except json.JSONDecodeError:\n                raise ValueError(f\"Invalid JSON at line {line_num}: {line[:100]}\")\n            \n            if not isinstance(obj, dict):\n                raise ValueError(f\"Line {line_num} is not a JSON object\")\n            \n            required_fields = {\"id\", \"category\", \"prompt\"}\n            missing = required_fields - set(obj.keys())\n            if missing:\n                raise ValueError(f\"Line {line_num} missing fields: {missing}\")\n            \n            cases.append(PromptCase(\n                id=obj[\"id\"],\n                category=obj[\"category\"],\n                prompt=obj[\"prompt\"],\n                max_tokens=obj.get(\"max_tokens\", 128),\n                notes=obj.get(\"notes\", \"\")\n            ))\n    \n    return cases\n\n\ndef write_prompt_suite(cases: Iterable[PromptCase], path: Path) -> None:\n    \"\"\"Write a prompt suite to a JSONL file.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    \n    with path.open(\"w\", encoding=\"utf-8\") as f:\n        for case in cases:\n            f.write(json.dumps(asdict(case), ensure_ascii=False) + \"\\n\")\n\n\ndef filter_by_category(cases: Iterable[PromptCase], category: str) -> list[PromptCase]:\n    \"\"\"Filter cases by exact category match.\"\"\"\n    return [c for c in cases if c.category == category]\n\n\ndef get_unique_shas(cases: Iterable[PromptCase]) -> set[str]:\n    \"\"\"Extract unique prompt hashes.\"\"\"\n    return {c.prompt_sha256 for c in cases}",
