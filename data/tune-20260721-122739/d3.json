          "text": "def load_prompt_suite(path: Path) -> list[PromptCase]:\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found at {path}\")\n    if not path.suffix.lower() == \".jsonl\":\n        raise ValueError(f\"Expected JSONL file, got {path.suffix}\")\n\n    cases: list[PromptCase] = []\n    for line_num, line in enumerate(path.read_text().splitlines(), start=1):\n        if not line.strip():\n            continue\n        try:\n            data: dict[str, Any] = json.loads(line)\n            if not isinstance(data, dict):\n                raise ValueError(f\"Line {line_num}: Expected object, got {type(data)}\")\n            if \"id\" not in data or \"category\" not in data or \"prompt\" not in data:\n                raise ValueError(f\"Line {line_num}: Missing required fields (id, category, prompt)\")\n            if not isinstance(data[\"id\"], str) or not data[\"id\"]:\n                raise ValueError(f\"Line {line_num}: 'id' must be a non-empty string\")\n            if not isinstance(data[\"category\"], str) or not data[\"category\"]:\n                raise ValueError(f\"Line {line_num}: 'category' must be a non-empty string\")\n            if not isinstance(data[\"prompt\"], str) or not data[\"prompt\"]:\n                raise ValueError(f\"Line {line_num}: 'prompt' must be a non-empty string\")\n            if \"max_tokens\" in data and not isinstance(data[\"max_tokens\"], int):\n                raise ValueError(f\"Line {line_num}: 'max_tokens' must be an integer\")\n            if \"notes\" in data and not isinstance(data[\"notes\"], str):\n                raise ValueError(f\"Line {line_num}: 'notes' must be a string\")\n\n            case = PromptCase(\n                id=data[\"id\"],\n                category=data[\"category\"],\n                prompt=data[\"prompt\"],\n                max_tokens=data.get(\"max_tokens\", 128),\n                notes=data.get(\"notes\", \"\"),\n            )\n            cases.append(case)\n        except json.JSONDecodeError as e:\n            raise ValueError(f\"Invalid JSON at line {line_num}: {e}\") from e\n    return cases",
