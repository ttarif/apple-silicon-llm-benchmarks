          "text": "```python\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found: {path}\")\n\n    cases: list[PromptCase] = []\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            stripped = line.strip()\n            if not stripped:\n                continue\n            \n            try:\n                data = json.loads(stripped)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON on line {line_num}: {e}\")\n\n            # Required fields validation\n            if \"id\" not in data or \"category\" not in data or \"prompt\" not in data:\n                raise ValueError(f\"Missing required fields (id, category, prompt) on line {line_num}\")\n\n            # Type coercion and validation\n            try:\n                case = PromptCase(\n                    id=str(data[\"id\"]),\n                    category=str(data[\"category\"]),\n                    prompt=str(data[\"prompt\"]),\n                    max_tokens=int(data.get(\"max_tokens\", 128)),\n                    notes=str(data.get(\"notes\", \"\"))\n                )\n            except (ValueError, TypeError) as e:\n                raise ValueError(f\"Type error on line {line_num}: {e}\")\n\n            cases.append(case)\n\n    return cases\n\n\ndef evaluate_prompt_case(case: PromptCase, response: str) -> dict[str, Any]:\n    \"\"\"\n    Evaluate a single prompt case against a response.\n    \n    Returns a deterministic evaluation result containing:\n    - case_id: The ID of the prompt case.\n    - prompt_hash: SHA-256 hash of the prompt.\n    - response_length: Length of the response string.\n    - token_estimate: Rough token count (chars / 4).\n    - status: \"valid\" if response is non-empty, \"empty\" otherwise.\n    \"\"\"\n    if not isinstance(response, str):\n        raise TypeError(f\"Response must be a string, got {type(response)}\")\n\n    response_length = len(response)\n    token_estimate = max(1, response_length // 4)  # Conservative estimate\n    \n    status = \"valid\" if response_length > 0 else \"empty\"\n\n    return {\n        \"case_id\": case.id,\n        \"prompt_hash\": case.prompt_sha256,\n        \"response_length\": response",
