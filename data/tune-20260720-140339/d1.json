          "text": "```python\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found: {path}\")\n    \n    raw_data: list[dict[str, Any]] = []\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            stripped = line.strip()\n            if not stripped:\n                continue\n            try:\n                obj: dict[str, Any] = json.loads(stripped)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON on line {line_num}: {e}\") from e\n            \n            if \"id\" not in obj or \"category\" not in obj or \"prompt\" not in obj:\n                raise ValueError(f\"Missing required fields (id, category, prompt) on line {line_num}\")\n            \n            raw_data.append(obj)\n\n    cases: list[PromptCase] = []\n    for obj in raw_data:\n        cases.append(PromptCase(\n            id=str(obj[\"id\"]),\n            category=str(obj[\"category\"]),\n            prompt=str(obj[\"prompt\"]),\n            max_tokens=int(obj.get(\"max_tokens\", 128)),\n            notes=str(obj.get(\"notes\", \"\"))\n        ))\n    \n    return cases\n\n\ndef save_prompt_suite(cases: Iterable[PromptCase], path: Path) -> None:\n    \"\"\"Save a list of PromptCases to a JSONL file.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"w\", encoding=\"utf-8\") as f:\n        for case in cases:\n            f.write(json.dumps(asdict(case), ensure_ascii=False) + \"\\n\")\n\n\ndef filter_by_category(cases: Iterable[PromptCase], category: str) -> list[PromptCase]:\n    \"\"\"Filter cases by exact category match.\"\"\"\n    return [c for c in cases if c.category == category]\n\n\ndef get_max_tokens(cases: Iterable[PromptCase]) -> int:\n    \"\"\"Return the maximum max_tokens value across all cases.\"\"\"\n    return max((c.max_tokens for c in cases), default=0)\n```",
