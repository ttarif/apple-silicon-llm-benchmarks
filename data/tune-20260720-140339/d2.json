          "text": "```python\n    results: list[PromptCase] = []\n    raw_text = path.read_text(encoding=\"utf-8\")\n    if not raw_text.strip():\n        return results\n\n    for line_num, line in enumerate(raw_text.splitlines(), start=1):\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            data: dict[str, Any] = json.loads(line)\n        except json.JSONDecodeError as e:\n            raise ValueError(f\"Invalid JSON on line {line_num} in {path}: {e}\") from e\n\n        required_fields = {\"id\", \"category\", \"prompt\"}\n        missing = required_fields - data.keys()\n        if missing:\n            raise ValueError(f\"Missing fields {missing} on line {line_num} in {path}\")\n\n        try:\n            case = PromptCase(\n                id=str(data[\"id\"]),\n                category=str(data[\"category\"]),\n                prompt=str(data[\"prompt\"]),\n                max_tokens=int(data.get(\"max_tokens\", 128)),\n                notes=str(data.get(\"notes\", \"\")),\n            )\n            results.append(case)\n        except (TypeError, ValueError) as e:\n            raise ValueError(f\"Type validation error on line {line_num} in {path}: {e}\") from e\n\n    return results\n\n\ndef save_prompt_suite(path: Path, cases: Iterable[PromptCase]) -> None:\n    \"\"\"Save a list of PromptCases to a JSONL file.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"w\", encoding=\"utf-8\") as f:\n        for case in cases:\n            f.write(json.dumps(asdict(case), ensure_ascii=False) + \"\\n\")\n\n\ndef filter_by_category(cases: Iterable[PromptCase], category: str) -> list[PromptCase]:\n    \"\"\"Return cases matching the specified category.\"\"\"\n    return [c for c in cases if c.category == category]\n\n\ndef compute_hashes(cases: Iterable[PromptCase]) -> dict[str, str]:\n    \"\"\"Return a mapping of case ID to prompt SHA-256 hash.\"\"\"\n    return {c.id: c.prompt_sha256 for c in cases}\n```",
