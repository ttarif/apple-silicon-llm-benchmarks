      "text": "```python\n    try:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            data = json.load(f)\n    except (json.JSONDecodeError, FileNotFoundError, OSError) as e:\n        raise ValueError(f\"Failed to load prompt suite from {path}: {e}\")\n\n    if not isinstance(data, list):\n        raise TypeError(f\"Expected a list of prompts, got {type(data).__name__}\")\n\n    cases: list[PromptCase] = []\n    for idx, item in enumerate(data):\n        if not isinstance(item, dict):\n            raise TypeError(f\"Item at index {idx} is not a dictionary\")\n        \n        try:\n            case = PromptCase(\n                id=str(item[\"id\"]),\n                category=str(item[\"category\"]),\n                prompt=str(item[\"prompt\"]),\n                max_tokens=int(item.get(\"max_tokens\", 128)),\n                notes=str(item.get(\"notes\", \"\"))\n            )\n            cases.append(case)\n        except KeyError as e:\n            raise KeyError(f\"Missing required field {e} in item at index {idx}\")\n        except (ValueError, TypeError) as e:\n            raise ValueError(f\"Invalid data for item at index {idx}: {e}\")\n\n    return cases\n\n\ndef save_prompt_suite(path: Path, cases: Iterable[PromptCase]) -> None:\n    \"\"\"Save a list of PromptCases to a JSON file.\"\"\"\n    try:\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            json.dump([asdict(c) for c in cases], f, indent=2, ensure_ascii=False)\n    except OSError as e:\n        raise OSError(f\"Failed to save prompt suite to {path}: {e}\")\n\n\ndef filter_cases(cases: list[PromptCase], category: str) -> list[PromptCase]:\n    \"\"\"Filter cases by category.\"\"\"\n    return [c for c in cases if c.category == category]\n\n\ndef get_case_by_id(cases: list[PromptCase], case_id: str) -> PromptCase | None:\n    \"\"\"Retrieve a case by its ID.\"\"\"\n    for c in cases:\n        if c.id == case_id:\n            return c\n    return None\n```",
